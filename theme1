function ProfileScreen(props: Props & { insetsBottom: number; onBack: () => void }) { const styles = useStyles(); const { colors } = useTheme(); const [name, setName] = useState(props.profile.name); const [bio, setBio] = useState(props.profile.bio); return <View style={[styles.root, { paddingTop: 20 }]}><View style={styles.profileTop}><Pressable onPress={props.onBack} style={styles.back}><Ionicons name="arrow-back" size={22} color={colors.onSurface} /></Pressable><Text style={styles.profileTitle}>Profile</Text><Pressable onPress={() => props.onSaveProfile({ name: name.trim() || props.user.name, bio: bio.trim() })}><Text style={styles.save}>Save</Text></Pressable></View><View style={styles.profileHero}><View style={styles.bigAvatar}><Text style={styles.bigAvatarText}>{name.slice(0, 1).toUpperCase()}</Text></View><Text style={styles.profileName}>{name || props.user.name}</Text><Text style={styles.profileEmail}>{props.user.email}</Text></View><View style={styles.profileForm}><Text style={styles.label}>DISPLAY NAME</Text><TextInput value={name} onChangeText={setName} style={styles.profileInput} placeholderTextColor={colors.muted} /><Text style={styles.label}>SHORT BIO</Text><TextInput value={bio} onChangeText={setBio} style={[styles.profileInput, styles.bioInput]} placeholder="What catches your eye?" placeholderTextColor={colors.muted} multiline /><View style={styles.stats}><Stat value={String(props.favorites.length)} label="SAVED" /><Stat value={String(props.items.length)} label="DISCOVERED" /></View><Pressable onPress={props.onLogout} style={styles.logout}><Ionicons name="log-out-outline" size={18} color={colors.error} /><Text style={styles.logoutText}>Sign out</Text></Pressable></View></View>; }
function Stat({ value, label }: { value: string; label: string }) { const styles = useStyles(); return <View style={styles.stat}><Text style={styles.statValue}>{value}</Text><Text style={styles.statLabel}>{label}</Text></View>; }

