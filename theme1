    {section === "gallery" && <View style={styles.searchWrap}><Ionicons name="search-outline" size={19} color={colors.muted} /><TextInput value={query} onChangeText={setQuery} placeholder="Search by author" placeholderTextColor={colors.muted} style={styles.search} accessibilityLabel="Search by author" /></View>}
    <FlatList data={filtered} keyExtractor={(item) => item.id} numColumns={2} columnWrapperStyle={styles.columns} contentContainerStyle={[styles.listContent, { paddingBottom: insets.bottom + 20 }]} refreshControl={<RefreshControl refreshing={props.refreshing} onRefresh={props.onRefresh} tintColor={colors.brand} />} renderItem={({ item, index }) => <ImageCard item={item} index={index} saved={props.favorites.some((favorite) => favorite.id === item.id)} onOpen={props.onOpen} onToggleFavorite={props.onToggleFavorite} />} onEndReached={props.onLoadMore} onEndReachedThreshold={0.7} ListHeaderComponent={<View>{section === "gallery" && <FilterRow selected={range} onSelect={setRange} />}{props.error ? <View style={styles.banner}><Ionicons name="cloud-offline-outline" size={18} color={colors.onWarning} /><Text style={styles.bannerText}>{props.error}</Text><Pressable onPress={props.onRefresh}><Text style={styles.retry}>Retry</Text></Pressable></View> : null}{props.loading && !props.items.length ? <View style={styles.loading}><ActivityIndicator color={colors.brand} /><Text style={styles.loadingText}>Preparing your gallery…</Text></View> : null}</View>} ListEmptyComponent={isEmpty ? <View style={styles.empty}><Ionicons name={section === "saved" ? "heart-outline" : "images-outline"} size={36} color={colors.brand} /><Text style={styles.emptyTitle}>{section === "saved" ? "Nothing saved yet" : "No images found"}</Text><Text style={styles.emptyText}>{section === "saved" ? "Tap the heart on an image to keep it close." : "Try another author or clear your filters."}</Text><Pressable onPress={() => { setQuery(""); setRange("All"); }}><Text style={styles.retry}>Clear filters</Text></Pressable></View> : null} ListFooterComponent={props.loading && props.items.length ? <ActivityIndicator style={styles.footerLoader} color={colors.brand} /> : null} />
  </View>;
}

function NavButton({ active, icon, label, onPress }: { active: boolean; icon: keyof typeof Ionicons.glyphMap; label: string; onPress: () => void }) { const styles = useStyles(); const { colors } = useTheme(); return <Pressable onPress={onPress} style={[styles.navButton, active && styles.navActive]}><Ionicons name={icon} size={17} color={active ? colors.brand : colors.muted} /><Text style={[styles.navText, active && styles.navTextActive]}>{label}</Text></Pressable>; }
function FilterRow({ selected, onSelect }: { selected: string; onSelect: (value: string) => void }) { const styles = useStyles(); const { colors } = useTheme(); return <View style={styles.filterRow}>{ranges.map((item) => <Pressable key={item} onPress={() => onSelect(item)} style={[styles.filter, selected === item && styles.filterSelected]}><Text style={[styles.filterText, selected === item && { color: colors.onBrandPrimary }]}>{item}</Text></Pressable>)}</View>; }
